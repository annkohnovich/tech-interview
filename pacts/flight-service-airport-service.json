{
  "consumer": {
    "name": "flight-service"
  },
  "interactions": [
    {
      "description": "a request for an existing airport",
      "key": "f250e6cf",
      "pending": false,
      "providerStates": [
        {
          "name": "airport WAW exists and is active"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/airports/WAW"
      },
      "response": {
        "body": {
          "content": {
            "active": true,
            "iata": "WAW",
            "name": "Warsaw Chopin"
          },
          "contentType": "application/json; charset=UTF-8",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json; charset=UTF-8"
          ]
        },
        "matchingRules": {
          "body": {
            "$.active": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json(;\\s?charset=[\\w\\-]+)?"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request for an unknown airport",
      "key": "edcebfd4",
      "pending": false,
      "providerStates": [
        {
          "name": "airport XYZ does not exist"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/airports/XYZ"
      },
      "response": {
        "status": 404
      },
      "transport": "http",
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.6.14"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "airport-service"
  }
}
